# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pixel-diff/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# env / secrets — never commit real keys (allow .env.example only)
.env
.env.*
!.env.example

# local user store
.data/

# FightScope analysis cache
.fightscope-cache/

# generated ESPN portrait cache (regenerate via portraits:ingest)
/public/portraits/espn/

# local agent / QA scratch (not product source)
.honeyloom-work/
.tmp-hero-shots/
.tmp-hero-verify/
.tmp-repair-qa/
.tmp-repair-qa2/
.tmp-*/

# generated backtest / eval reports
/reports/

# gated backtest candidate dumps (keep production.json + versioned artifact)
src/server/prediction/artifacts/candidate-*.json
src/server/prediction/artifacts/candidate-latest.json

# vercel / netlify local
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts
