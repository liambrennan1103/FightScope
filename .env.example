# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public site URL (no trailing slash). Used for Stripe success/cancel + portal return.
# Netlify also provides URL / DEPLOY_PRIME_URL as fallbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — enables LLM narrative rewrite from structured FightScope results only.
# Without this key, template explanations are used (numbers still come from the engine).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Supabase — Auth + profiles (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server-only secret / service-role (NEVER NEXT_PUBLIC_ / never duplicate publishable)
# Used for analysis cache, Stripe webhook entitlement writes, admin jobs.
SUPABASE_SECRET_KEY=
# Legacy aliases still accepted by server code:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing (server-only — never expose secret/webhook to the client)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Optional comma-separated legacy price IDs still mapped by webhooks
STRIPE_PRICE_STARTER_LEGACY=
STRIPE_PRICE_PRO_LEGACY=

# Protects /api/jobs/run and Netlify scheduled function → site calls
CRON_SECRET=

# Local / staging only — force a plan without Stripe
# FIGHTSCOPE_DEV_PLAN=starter
# FIGHTSCOPE_ALLOW_DEV_PLAN=1

# Snapshot refresh: set to 1 to skip ESPN fight-stat HTML scrape (faster, rates stay null).
# FIGHTSCOPE_SKIP_FIGHT_STATS=0
# FIGHTSCOPE_STATS_CONCURRENCY=4
